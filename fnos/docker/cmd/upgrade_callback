#!/bin/bash
#
# Oi — 升级后回调
# 升级会重装包内向导文件（wizard/config 恢复成带占位符的模板），
# 这里用现有 docker/.env 的用户名重新渲染「设置」窗口，
# 并确认应急备份 oi-login.txt 存在（不覆盖用户已在 Web 内修改的密码，
# 仅在备份缺失时按 .env 重建）。新版镜像由应用中心拉取并重建容器。
#
set -euo pipefail

_OI_COMMON="$(dirname "$0")/common.sh"
[ -f "$_OI_COMMON" ] || _OI_COMMON="/var/apps/oi/cmd/common.sh"
[ -f "$_OI_COMMON" ] && source "$_OI_COMMON"

ENV_FILE="${TRIM_APPDEST:-/var/apps/oi/target}/docker/.env"
# 升级会替换 target/，先从 @appdata 恢复 .env，再挂回 data-share 并迁旧目录。
DATA_DIR="$(oi_prepare_docker_persist "$ENV_FILE")"
mkdir -p "$DATA_DIR"

ADMIN_USER="$(oi_env_get "$ENV_FILE" OI_ADMIN_USERNAME)"
ADMIN_PASS="$(oi_env_get "$ENV_FILE" OI_DEFAULT_PASSWORD)"
ADMIN_DISPLAY="$(oi_env_get "$ENV_FILE" OI_ADMIN_DISPLAY_NAME)"
ADMIN_EMAIL="$(oi_env_get "$ENV_FILE" OI_ADMIN_EMAIL)"
[ -n "$ADMIN_USER" ] || ADMIN_USER="admin"

if [ -n "$ADMIN_PASS" ]; then
    # 「设置」窗口用户名刷新
    WIZARD_TEMPLATE="${TRIM_APPDEST:-/var/apps/oi/target}/wizard/config.template"
    WIZARD_DIR="$(dirname "${TRIM_APPDEST:-/var/apps/oi/target}")/wizard"
    [ -f "$WIZARD_TEMPLATE" ] || WIZARD_TEMPLATE="${TRIM_APPDEST:-/var/apps/oi/target}/../wizard/config"
    oi_render_config_wizard "$WIZARD_TEMPLATE" "$WIZARD_DIR" "$ADMIN_USER" "$ADMIN_PASS" "$DATA_DIR"
    # 回落备份缺失时按 .env 重建（存在则不动，尊重用户在 Web 内改过的密码）
    if [ ! -f "${DATA_DIR}/oi-login.txt" ]; then
        oi_write_login_file "$DATA_DIR" "$ADMIN_USER" "$ADMIN_PASS" 8088
    fi
    oi_write_fnos_bootstrap "$DATA_DIR" "$ADMIN_USER" "$ADMIN_PASS" "$ADMIN_DISPLAY" "$ADMIN_EMAIL"
fi

exit 0
