#!/bin/bash
#
# oi — 飞牛本地版「官方 CLI」包装
#
# 复刻 oi 运行环境后调用 `python -m oi.cli.main`，因此可使用全部官方子命令：
#   oi --help
#   oi version
#   oi provider list
#   oi agent list
#   oi user list
#   ...（还包括 init / run / config / backup / skills / update / clean 等）
#
# 注意：本机 Web 服务由飞牛应用中心托管（cmd/main 拉起 bin/oi），
# 请勿手动执行 `oi run`（会与飞牛管理的实例抢 8089 端口）。
#
# 本包装以 oi-native 身份运行，避免产生 root 所有的数据文件
# （Web 服务本身也以 oi-native 运行，混用 root 会导致后续权限问题）。
# root 调用 sudo 免密；其他用户调用需输入自身 sudo 密码。
#
set -euo pipefail

# 共享函数库（find_python312 / fix_ownership_and_perms / free_oi_ports）
# 打包时由 scripts/build-fpk.sh 注入；仓库内运行无此文件时跳过（函数缺失时再报错）。
# 注意：FPK 解包后 cmd/ 落在 /var/apps/oi-native/cmd（管理目录），而本文件位于
# 负载目录 $TRIM_APPDEST/bin，`$0/../cmd` 指向载荷内不存在的位置，故需回退到
# 外层 cmd 的实际落点。
_OI_COMMON="$(dirname "$0")/../cmd/common.sh"
[ -f "$_OI_COMMON" ] || _OI_COMMON="/var/apps/oi-native/cmd/common.sh"
[ -f "$_OI_COMMON" ] && source "$_OI_COMMON"

APPDEST="${TRIM_APPDEST:-/var/apps/oi-native}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/oi-native/var}"

# 数据目录：优先飞牛 data-share 共享目录，否则回退包内目录
if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
    DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
else
    DATA_DIR="$APPDEST/shares/oi-native/data"
fi

mkdir -p "$DATA_DIR" "$PKGVAR"

# 加载安装向导写入的配置（OI_PORT / 管理员账号 等）
if [ -f "$PKGVAR/.env" ]; then
    set -a; . "$PKGVAR/.env"; set +a
fi

# 查找飞牛应用商店提供的 Python 3.12

if type oi_assert_native_arch >/dev/null 2>&1; then
    if ! REASON="$(oi_assert_native_arch)"; then
        echo "[oi] $REASON" >&2
        exit 1
    fi
fi

if type oi_prepend_fnos_node_path >/dev/null 2>&1; then
    oi_prepend_fnos_node_path
fi

PY="$(find_python312)" || {
    echo "错误：未找到 Python 3.12，请先在飞牛应用中心安装「Python 3.12」开发工具。" >&2
    exit 1
}

# 关键环境变量：让 oi 找到包本体（site-packages）与你的数据目录
SITE_PACKAGES="$APPDEST/site-packages"
export PYTHONPATH="${SITE_PACKAGES}${PYTHONPATH:+:$PYTHONPATH}"
export HOME="$DATA_DIR"
export OI_HOME="$DATA_DIR/.oi"
export OI_DATA_DIR="$DATA_DIR"

# 内置在线升级优先使用 uv（pip 对 oi-harness[all] 依赖树解析会卡死）。
# 系统无 uv 且当前为 root 时自动安装一次（装到系统 Python bin，软链到 /usr/local/bin）。
if [ "$(id -u)" = "0" ] && ! command -v uv >/dev/null 2>&1; then
    "$PY" -m pip install -q --disable-pip-version-check uv 2>/dev/null || true
    if [ -x "$(dirname "$PY")/uv" ]; then
        ln -sf "$(dirname "$PY")/uv" /usr/local/bin/uv 2>/dev/null || true
    fi
fi

# 飞牛 FPK 部署标识 + 打包 site-packages 路径：内置在线升级安装到此目录
# （launcher 实际加载的位置），重启服务后即加载新版，升级真正生效
# （见 src/oi/infra/setup/self_update.py 的 _run_fpk_upgrade）。
export OI_INSTALL_MODE="fpk-native"
export OI_FPK_SITE_PACKAGES="$SITE_PACKAGES"

# 兜底：若包内 oi 未就绪，用内置核心 whl 离线安装（避免联网）
if ! "$PY" -c "import oi" >/dev/null 2>&1; then
    echo "[oi] 未检测到已安装的 Oi，正在用内置核心 whl 离线安装 ..."
    "$PY" -m pip install --no-cache --no-index --find-links "$SITE_PACKAGES" "$SITE_PACKAGES/oi.whl" >/dev/null 2>&1 || {
        echo "[oi] 离线安装失败，请检查网络或手动执行：$PY -m pip install $SITE_PACKAGES/oi.whl" >&2
        exit 1
    }
fi

# 以 oi-native 身份运行，避免产生 root 所有的数据文件
if id oi-native >/dev/null 2>&1 && command -v sudo >/dev/null 2>&1; then
    exec sudo -u oi-native \
        PYTHONPATH="$PYTHONPATH" \
        HOME="$HOME" \
        OI_HOME="$OI_HOME" \
        OI_DATA_DIR="$OI_DATA_DIR" \
        OI_INSTALL_MODE="$OI_INSTALL_MODE" \
        OI_FPK_SITE_PACKAGES="$OI_FPK_SITE_PACKAGES" \
        "$PY" -m oi.cli.main "$@"
else
    exec "$PY" -m oi.cli.main "$@"
fi
